# LibreQR — variables de entorno (plantilla)
# Copiar a `.env` y ajustar. El docker-compose.yml lee este `.env`.
# NO subir el `.env` real al repositorio.

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=cambiar_esta_password
MONGO_DB=libreqr
MONGO_USER=libreqr
MONGO_PASSWORD=cambiar_esta_password

# --- Backend ---
SERVER_PORT=8080
